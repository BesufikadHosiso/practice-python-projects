{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.py" }],
  "functions": { "api/index.py": { "memory": 512, "maxDuration": 30 } }
}
